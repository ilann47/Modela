@model Modela.Models.Cliente

@{
	ViewData["Title"] = "Novo Cliente";
	List<Estado> estados = ViewData["Estados"] as List<Estado> ?? new List<Estado>();
	List<Cidade> cidades = ViewData["Cidades"] as List<Cidade> ?? new List<Cidade>();
	int selectedEstadoId = ViewData["SelectedEstadoId"] as int? ?? 0;
}

<div class="container mt-5">
	<h1 class="mb-4 text-center">@ViewData["Title"]</h1>

	<form method="post">
		<div class="row">
			<div class="col-md-6">
				<div class="mb-3">
					<label for="Nome" class="form-label">Nome</label>
					<input type="text" class="form-control" id="Nome" name="Nome" value="@Model.Nome" required />
				</div>

				<div class="mb-3">
					<label for="CPF" class="form-label">CPF</label>
					<input type="text" class="form-control" id="CPF" name="CPF" value="@Model.CPF" />
				</div>

				<div class="mb-3">
					<label for="RG" class="form-label">RG</label>
					<input type="text" class="form-control" id="RG" name="RG" value="@Model.RG" />
				</div>

				<div class="mb-3">
					<label for="DataNascimento" class="form-label">Data de Nascimento</label>
					<input type="date" class="form-control" id="DataNascimento" name="DataNascimento" value="@Model.DataNascimento.ToString("yyyy-MM-dd")" />
				</div>

				<div class="mb-3">
					<label for="Telefone" class="form-label">Telefone</label>
					<input type="text" class="form-control" id="Telefone" name="Telefone" value="@Model.Telefone" />
				</div>

				<div class="mb-3">
					<label for="Sexo" class="form-label">Sexo</label>
					<select class="form-control" id="Sexo" name="Sexo" required>
						<option value="">Selecione o Sexo</option>
						@Html.Raw($"<option value=\"M\" {(Model.Sexo == 'M' ? "selected" : "")}>Masculino</option>")
						@Html.Raw($"<option value=\"F\" {(Model.Sexo == 'F' ? "selected" : "")}>Feminino</option>")
						@Html.Raw($"<option value=\"O\" {(Model.Sexo == 'O' ? "selected" : "")}>Outro</option>")
					</select>
				</div>

				<div class="mb-3">
					<label for="Estado" class="form-label">Estado</label>
					<select class="form-control" id="Estado" name="selectedEstadoId" onchange="this.form.submit()">
						<option value="">Selecione o Estado</option>
						@foreach (var estado in estados) {
							@Html.Raw($"<option value=\"{@estado.Id}\" " + (estado.Id == selectedEstadoId ? "selected" : "") + $" >{estado.Nome}</option>")
						}
					</select>
				</div>
			</div>

			<div class="col-md-6">
				<div class="mb-3">
					<label for="Email" class="form-label">Email</label>
					<input type="email" class="form-control" id="Email" name="Email" value="@Model.Email" />
				</div>

				<div class="mb-3">
					<label for="EstadoCivil" class="form-label">Estado Civil</label>
					<input type="text" class="form-control" id="EstadoCivil" name="EstadoCivil" value="@Model.EstadoCivil" />
				</div>

				<div class="mb-3">
					<label for="CEP" class="form-label">CEP</label>
					<input type="text" class="form-control" id="CEP" name="CEP" value="@Model.CEP" />
				</div>

				<div class="mb-3">
					<label for="Logradouro" class="form-label">Logradouro</label>
					<input type="text" class="form-control" id="Logradouro" name="Logradouro" value="@Model.Logradouro" />
				</div>

				<div class="mb-3">
					<label for="Numero" class="form-label">Número</label>
					<input type="text" class="form-control" id="Numero" name="Numero" value="@Model.Numero" />
				</div>

				<div class="mb-3">
					<label for="Complemento" class="form-label">Complemento</label>
					<input type="text" class="form-control" id="Complemento" name="Complemento" value="@Model.Complemento" />
				</div>

				<div class="mb-3">
					<label for="Cidade" class="form-label">Cidade</label>
					<select class="form-control" id="Cidade" name="cidadeNome">
						<option value="">Selecione a Cidade</option>
						@foreach (var cidade in cidades) {
							<option value="@cidade.Nome">@cidade.Nome</option>
						}
					</select>
				</div>
			</div>
		</div>

		<button type="submit" class="btn btn-success" name="isSubmit" value="true">Criar Cliente</button>
	</form>
</div>
