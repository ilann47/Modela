@model Modela.Models.Cliente
<h1>Deletar Cliente</h1>
<p>Tem certeza de que deseja deletar o cliente abaixo?</p>
<ul>
    <li>CPF: @Model.CPF</li>
    <li>Nome: @Model.RG</li>
    <li>Telefone: @Model.Telefone</li>
    <li>Cidade: @Model.Cidade</li>
</ul>
<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="ClienteId" />
    <button type="submit">Confirmar</button>
    <a href="@Url.Action("Index")">Cancelar</a>
</form>
