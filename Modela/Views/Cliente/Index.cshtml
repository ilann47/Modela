@model List<Modela.Models.Cliente>
<h1>Clientes</h1>
<table>
    <tr>
        <th>Nome</th>
        <th>CPF</th>
        <th>RG</th>
        <th>Data de Nascimento</th>
        <th>Telefone</th>
        <th>Email</th>
        <th>Sexo</th>
        <th>Estado Civil</th>
        <th>CEP</th>
        <th>Logradouro</th>
        <th>Número</th>
        <th>Complemento</th>
        <th>Cidade</th>
        <th>Ações</th>
    </tr>
    @foreach (var cliente in Model)
    {
        <tr>
            <td>@cliente.Nome</td>
            <td>@cliente.CPF</td>
            <td>@cliente.RG</td>
            <td>@cliente.DataNascimento</td>
            <td>@cliente.Telefone</td>
            <td>@cliente.Email</td>
            <td>@cliente.Sexo</td>
            <td>@cliente.EstadoCivil</td>
            <td>@cliente.CEP</td>
            <td>@cliente.Logradouro</td>
            <td>@cliente.Numero</td>
            <td>@cliente.Complemento</td>
            <td>@cliente.OCidade?.Nome</td>
            <td>
                <a href="@Url.Action("Edit", new { id = cliente.ClienteId })">Editar</a> |
                <a href="@Url.Action("Delete", new { id = cliente.ClienteId })">Deletar</a>
            </td>
        </tr>
    }
</table>
<a href="@Url.Action("Create")">Novo Cliente</a>
