@model List<Cliente>

@{
    ViewData["Title"] = "Lista de Clientes";
}

<div class="container mt-5">
    <div class="container mt-5">
        <div class="d-flex flex-row justify-content-between align-items-center mb-4">
            <h1>@ViewData["Title"]</h1>
            <a href="@Url.Action("Create")" class="btn btn-success">Novo Cliente</a>
        </div>
    </div>

    <div class="d-flex justify-content-center">
        <table class="table table-striped table-bordered w-auto">
            <thead class="thead-dark">
                <tr>
                    <th class="text-center align-middle">Nome</th>
                    <th class="text-center align-middle">CPF</th>
                    <th class="text-center align-middle">RG</th>
                    <th class="text-center align-middle">Data de Nascimento</th>
                    <th class="text-center align-middle">Telefone</th>
                    <th class="text-center align-middle">Email</th>
                    <th class="text-center align-middle">Sexo</th>
                    <th class="text-center align-middle">Estado Civil</th>
                    <th class="text-center align-middle">CEP</th>
                    <th class="text-center align-middle">Logradouro</th>
                    <th class="text-center align-middle">Número</th>
                    <th class="text-center align-middle">Complemento</th>
                    <th class="text-center align-middle">Cidade</th>
                    <th class="text-center align-middle">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model) {
                    <tr>
                        <td>@cliente.Nome</td>
                        <td>@cliente.CPF</td>
                        <td>@cliente.RG</td>
                        <td>@cliente.DataNascimento.ToString("dd/MM/yyyy")</td>
                        <td>@cliente.Telefone</td>
                        <td>@cliente.Email</td>
                        <td>@cliente.Sexo</td>
                        <td>@cliente.EstadoCivil</td>
                        <td>@cliente.CEP</td>
                        <td>@cliente.Logradouro</td>
                        <td>@cliente.Numero</td>
                        <td>@cliente.Complemento</td>
                        <td>@cliente.Cidade</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="@Url.Action("Edit", new { id = cliente.ClienteId })" class="btn btn-primary btn-sm">Editar</a>
                                <a href="@Url.Action("Delete", new { id = cliente.ClienteId })" class="btn btn-danger btn-sm">Deletar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
